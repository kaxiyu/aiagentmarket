# Cloudflare Worker Environment Secrets
# These secrets MUST NOT be committed to git or stored in plaintext.
# In production, configure them using:
#   npx wrangler secret put ADMIN_EMAIL
#   npx wrangler secret put ADMIN_PASSWORD_HASH
#   npx wrangler secret put ADMIN_SESSION_SECRET

ADMIN_EMAIL="admin@internal.system"
# Generated using: node scripts/hash-password.js "YourSecureAdminPassword"
ADMIN_PASSWORD_HASH="pbkdf2$600000$salt_in_hex$hash_in_hex"
# 32+ random characters for signing admin session cookies
ADMIN_SESSION_SECRET="generate_at_least_32_characters_random_secret_here"
